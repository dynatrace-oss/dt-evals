{
  "name": "dt-eval-deploy",
  "version": "0.1.0",
  "description": "Serverless packaging and Terraform modules for dt-eval (Lambda, Cloud Run, Azure Functions)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "terraform"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "dt-eval-lib": "*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
