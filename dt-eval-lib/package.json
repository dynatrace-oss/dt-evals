{
  "name": "@dynatrace-oss/dt-eval-lib",
  "version": "0.0.15-alpha",
  "type": "module",
  "description": "Minimal TypeScript library for running LLM-as-a-judge evaluations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "e2e:azure": "tsx _temp_tests/azure-openai-e2e.ts",
    "e2e:bedrock": "tsx _temp_tests/bedrock-e2e.ts",
    "e2e:vertex": "tsx _temp_tests/vertex-e2e.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "LLM",
    "AI",
    "evaluation",
    "prompts",
    "experimentation"
  ],
  "homepage": "https://github.com/dynatrace-oss/dt-evals#readme",
  "bugs": {
    "url": "https://github.com/dynatrace-oss/dt-evals/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynatrace-oss/dt-evals.git"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@google/genai": "^1.0.0",
    "openai": "^4.73.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1031.0",
    "@biomejs/biome": "2.4.9",
    "@google/genai": "^1.0.0",
    "dotenv": "^17.3.1",
    "openai": "^4.73.0",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "sideEffects": false
}
