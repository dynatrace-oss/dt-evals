# Dynatrace environment
DT_ENDPOINT=https://<your-env-id>.live.dynatrace.com
DT_ACCESS_TOKEN=<your-access-token>

# LLM judge (required for live script: 02_live_evaluation_bizevents)
OPENAI_API_KEY=sk-...

# Optional: OpenAI-compatible proxy (e.g. Langdock)
# OPENAI_BASE_URL=https://chat.langdock.internal.dynatrace.com/api/public/openai/eu/v1/

# Optional: override model (default: gpt-4o)
# LLM_MODEL=gpt-5-mini
