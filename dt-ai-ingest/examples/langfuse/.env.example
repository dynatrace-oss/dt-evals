# Dynatrace environment
DT_ENDPOINT=https://<your-env-id>.live.dynatrace.com
DT_ACCESS_TOKEN=<your-access-token>

# LLM (required for live script: 02_live_scores_and_tracing)
OPENAI_API_KEY=sk-...

# Optional: OpenAI-compatible proxy (e.g. Langdock)
# OPENAI_BASE_URL=https://chat.langdock.com/api/public/openai/eu/v1/

# Optional: override model (default: gpt-4o)
# LLM_MODEL=gpt-5-mini

# Langfuse connection (required for score export in 02_live_scores_and_tracing)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
#LANGFUSE_BASE_URL="http://localhost:3000"
