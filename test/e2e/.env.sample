# dt-evals E2E suite — local configuration
#
# Copy to .env and fill in. Real environment variables always win over this file,
# so CI secrets take precedence. This file is gitignored.
#
#   cp .env.sample .env
#   npm run test:e2e

# ─── Tenant (required) ───────────────────────────────────────────────────────
#
# The tenant the fixture spans are seeded into. This must be the tenant that
# dynatrace-ai-agent-instrumentation-examples' E2E workflow targets, NOT whichever
# tenant you normally run dt-evals against — the suite consumes spans that repo's
# CI produces and does not seed anything itself.
#
# Note the naming: the suite prefers DT_APPS_ENDPOINT (the instrumentation-examples
# convention for the platform/apps host that serves the DQL API) and accepts
# DT_ENV_URL as a fallback, which is what the CLI itself reads and what this repo's
# existing tenant workflow already uses as a secret. Both mean the same host; the
# suite translates when it spawns the CLI. See tenantCliEnv() in src/cli.ts.
#
# Left blank on purpose: this repo is public, and a real tenant hostname here
# would both publish internal infrastructure and contradict the workflow, which
# treats this value as a secret (E2E_DT_APPS_ENDPOINT).
DT_APPS_ENDPOINT=

# Platform token (dt0s16…) or API token (dt0c01…) for that tenant.
# Required scopes: storage:spans:read, storage:buckets:read, storage:events:read,
# storage:events:write, storage:metrics:write, storage:logs:read
DT_API_TOKEN=

# ─── Judge provider (required for the validate and run suites) ───────────────
#
# Which provider scores the spans. The contract suite needs none of this — it is
# pure DQL. Defaults to bedrock, matching the AWS credentials the
# instrumentation-examples suite already provisions.
#
# One of: bedrock | openai | anthropic | azure-openai | gemini | vertex
# — the full set dt-eval-cli accepts.
E2E_JUDGE_PROVIDER=bedrock

# Optional model override. Each provider has a sensible default
# (dt-eval-cli/src/config/defaults.ts); azure-openai has none, because the
# deployment name is user-defined, so set it explicitly there.
# E2E_JUDGE_MODEL=

# bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# openai
# OPENAI_API_KEY=

# anthropic
# ANTHROPIC_API_KEY=

# azure-openai (all four are required, including the deployment name as the model)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=
# E2E_JUDGE_MODEL=

# gemini — either name works; the suite exports both, because `validate` accepts
# either while the library's `run` path only reads GOOGLE_API_KEY.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# vertex — no API key. It authenticates through Application Default Credentials,
# so the runner needs either a service-account key file pointed at by
# GOOGLE_APPLICATION_CREDENTIALS or Workload Identity. GOOGLE_CLOUD_LOCATION
# defaults to "global".
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=

# ─── Knobs (optional) ────────────────────────────────────────────────────────

# Treat missing credentials as a failure instead of a skip. CI must set this: a
# suite that skips everything still reports green, which is how E2E suites rot.
# E2E_REQUIRE_ENV=1

# How far back to look for fixture spans, as a DQL duration. The default assumes
# the upstream nightly seeded within the last day. Widen it when working against
# a tenant seeded on a different cadence — for example a tenant you seeded by
# hand a few days ago.
# E2E_FIXTURE_LOOKBACK=24h

# Which service.name the `run` journeys evaluate. Defaults to the fixture service.
# Override to point the structural run assertions at any tenant with GenAI traffic —
# they assert output shape, exit codes, the run log and the destination round-trip,
# none of which depend on the fixtures' specific content.
# E2E_RUN_SERVICE=dt-evals-fixtures

# Per-request HTTP timeout for Dynatrace platform API calls, in milliseconds.
# Must exceed the server-side 25s query timeout with headroom.
# E2E_DT_HTTP_TIMEOUT=60000

# A second tenant token, deliberately issued WITHOUT storage:spans:read but WITH
# storage:logs:read (so the connection probe still passes). Unlocks the one
# validate failure case that a merely invalid token cannot provoke — see the
# README. The test skips when this is unset.
# E2E_DT_MISSCOPED_TOKEN=
