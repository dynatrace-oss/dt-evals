# dt-evals E2E suite — local configuration
# cp .env.sample .env, then: npm run test:e2e
# Real environment variables always win over this file. Gitignored.

# ─── Tenant (required) ──────────────────────────────────────────────
# Must be the tenant dynatrace-ai-agent-instrumentation-examples seeds fixture
# spans into, not your usual dt-evals tenant — this suite doesn't seed its own.
# Blank on purpose: this repo is public. Accepts DT_ENV_URL as a fallback name.
DT_APPS_ENDPOINT=
# Scopes: storage:spans:read, storage:buckets:read, storage:events:read,
# storage:events:write, storage:metrics:write, storage:logs:read
DT_API_TOKEN=

# ─── Judge provider (required for validate/run) ─────────────────────
# One of: bedrock | openai | anthropic | azure-openai | gemini | vertex
E2E_JUDGE_PROVIDER=bedrock
# Optional model override; every provider has a default except azure-openai.
# E2E_JUDGE_MODEL=

# bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# openai
# OPENAI_API_KEY=

# anthropic
# ANTHROPIC_API_KEY=

# azure-openai (all four required; deployment name is the model)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=
# E2E_JUDGE_MODEL=

# gemini (either name works)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# vertex (Application Default Credentials, no API key)
# GCLOUD_PROJECT and GCP_PROJECT_ID are accepted as fallbacks for the project.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=   # must be an absolute path: the CLI runs with a throwaway HOME

# ─── Knobs (optional) ────────────────────────────────────────────────
# E2E_REQUIRE_ENV=1                   # fail instead of skip on missing creds (CI sets this)
# E2E_FIXTURE_LOOKBACK=24h            # how far back to look for fixture spans
# E2E_RUN_SERVICE=dt-evals-fixtures   # service the `run` suite evaluates
# E2E_DT_HTTP_TIMEOUT=60000           # per-request HTTP timeout, ms
# E2E_DT_MISSCOPED_TOKEN=             # 2nd token w/o storage:spans:read — see README
# E2E_REQUIRE_MISSCOPED_TOKEN=1       # once the token above exists, make its absence a failure
#                                     # rather than a silent skip (E2E_REQUIRE_ENV can't cover it)
