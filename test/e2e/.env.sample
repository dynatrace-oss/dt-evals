# dt-evals E2E suite. cp .env.sample .env, then: npm run test:e2e
# Real environment variables win over this file. Gitignored.

# Dynatrace tenant that the instrumentation-examples CI seeds fixtures into —
# not your usual dt-evals tenant.
#   live:   https://your-tenant.apps.dynatrace.com
#   sprint: https://your-tenant.sprint.apps.dynatracelabs.com
# Left blank deliberately: the suite skips on an empty value, so an uncopied
# sample skips cleanly instead of failing on DNS. (Also, this repo is public.)
DT_APPS_ENDPOINT=
# dt0s16… or dt0c01…; scopes: storage:spans:read, storage:buckets:read,
# storage:logs:read, storage:events:read, storage:events:write, storage:metrics:write
# (comment-only lines: loadDotEnv() takes everything after `=` literally, so an
# inline comment here would become part of the token value instead of staying blank)
DT_API_TOKEN=

# Judge provider. bedrock is the default and what CI uses; openai, anthropic,
# azure-openai, gemini and vertex also work — see README for their variables.
E2E_JUDGE_PROVIDER=bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# E2E_JUDGE_MODEL=              # optional; every provider but azure-openai has a default

# Optional knobs
# E2E_REQUIRE_ENV=1             # fail instead of skip on missing creds (CI sets this)
# E2E_FIXTURE_LOOKBACK=24h      # how far back to look for fixture spans
# E2E_RUN_SERVICE=dt-evals-fixtures
# E2E_DT_HTTP_TIMEOUT=60000     # per-request HTTP timeout, ms
